<workout_file>
  <name>Sweet spot 3 x 10 min</name>
  <description>Trois blocs de 10 minutes à 90 % du FTP, récupération de 4 minutes.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75"/>
    <IntervalsT Repeat="3" OnDuration="600" OffDuration="240" OnPower="0.90" OffPower="0.50"/>
    <Cooldown Duration="360" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
