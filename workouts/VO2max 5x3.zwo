<workout_file>
  <name>VO2max 5 x 3 min</name>
  <description>Cinq efforts de 3 minutes à 115 % du FTP, récupération de 3 minutes.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80"/>
    <SteadyState Duration="120" Power="0.50"/>
    <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.45"/>
    <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40"/>
  </workout>
</workout_file>
